<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Cutie shop - Official</title>

<link href="https://fonts.googleapis.com/css2?family=Mitr:wght@300;400;500&display=swap" rel="stylesheet">

<style>

:root{
--bg:#FFF7FB;
--main:#E1BEE7;
--pink:#F8BBD0;
--dark:#A64AC9;
--white:#FFFFFF;
--soft:#FDF1F8;
--glow:rgba(225,190,231,.45);
}

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Mitr',sans-serif;
}

body{
background:linear-gradient(to bottom,#FFF7FB,#FDF1F8);
display:flex;
justify-content:center;
min-height:100vh;
padding:20px;
}

.container{
width:100%;
max-width:540px;
}

.section{
background:var(--white);
border:2px solid var(--main);
border-radius:24px;
padding:22px;
margin-bottom:20px;
box-shadow:0 10px 25px rgba(0,0,0,.05);
}

.center{
text-align:center;
}

h1,h2,h3{
color:var(--dark);
margin-bottom:12px;
}

p{
color:#666;
}

.logo{
width:150px;
height:150px;
border-radius:50%;
overflow:hidden;
margin:auto;
border:5px solid white;
box-shadow:0 8px 25px var(--glow);
}

.logo img{
width:100%;
height:100%;
object-fit:cover;
}

/* รูปใต้ชื่อร้าน */
.banner-box{
margin-top:18px;
width:100%;
height:220px;
border-radius:22px;
overflow:hidden;
border:3px solid var(--pink);
box-shadow:0 8px 20px var(--glow);
background:white;
}

.banner-box img{
width:100%;
height:100%;
object-fit:cover;
}

.badges{
display:flex;
flex-wrap:wrap;
justify-content:center;
gap:10px;
margin-top:20px;
}

.badge{
background:white;
border:1.5px solid var(--main);
padding:9px 15px;
border-radius:999px;
font-size:13px;
color:var(--dark);
box-shadow:0 4px 12px var(--glow);
}

.price-row{
display:flex;
justify-content:space-between;
align-items:center;
background:var(--soft);
padding:12px 14px;
border-radius:16px;
margin-bottom:12px;
border-left:5px solid var(--pink);
}

.price-tag{
background:var(--pink);
color:white;
padding:4px 12px;
border-radius:999px;
font-size:13px;
}

.btn{
display:block;
width:100%;
padding:14px;
margin-top:14px;
text-align:center;
border-radius:999px;
text-decoration:none;
font-weight:500;
transition:.3s;
}

.btn-outline{
border:2px dashed var(--main);
background:white;
color:var(--dark);
}

.btn-outline:hover{
background:var(--soft);
}

.step{
display:flex;
align-items:center;
gap:12px;
margin-bottom:12px;
color:#555;
}

.step-num{
width:28px;
height:28px;
border-radius:50%;
background:var(--pink);
color:white;
display:flex;
align-items:center;
justify-content:center;
font-size:13px;
font-weight:bold;
}

.footer{
text-align:center;
margin-top:25px;
}

.socials{
display:flex;
justify-content:center;
gap:10px;
margin-top:15px;
flex-wrap:wrap;
}

.socials a{
flex:1;
max-width:120px;
padding:10px;
border-radius:999px;
text-decoration:none;
background:white;
border:1.5px solid var(--main);
color:var(--dark);
font-size:13px;
transition:.3s;
}

.socials a:hover{
background:var(--soft);
}

.small{
font-size:12px;
opacity:.7;
margin-top:10px;
}

/* ช่องเช็คคิว */
.queue-box{
margin-top:15px;
background:var(--soft);
padding:15px;
border-radius:18px;
border:2px dashed var(--main);
}

.queue-box textarea{
width:100%;
height:130px;
border:none;
outline:none;
resize:none;
border-radius:15px;
padding:12px;
font-size:14px;
background:white;
color:#555;
box-shadow:inset 0 2px 8px rgba(0,0,0,.05);
}

/* ตัวอย่างงาน */
.work-list{
display:flex;
flex-direction:column;
gap:10px;
margin-top:15px;
}

.work-card{
background:var(--soft);
padding:12px;
border-radius:15px;
border:1.5px solid var(--main);
}

.work-card a{
text-decoration:none;
color:var(--dark);
font-size:14px;
word-break:break-all;
}

/* ระบบตั้งค่า */
.admin-panel{
margin-top:20px;
padding:15px;
background:#fff;
border-radius:18px;
border:2px dashed var(--pink);
}

.admin-panel input,
.admin-panel select{
width:100%;
padding:12px;
margin-top:10px;
border-radius:12px;
border:1px solid var(--main);
outline:none;
}

.admin-note{
font-size:12px;
margin-top:10px;
color:#777;
}

</style>
</head>

<body>

<div class="container">

<!-- ส่วนหัว -->
<div class="section center">

<div class="logo">
<img src="https://via.placeholder.com/150" alt="Logo">
</div>

<h1 id="shopName">Cutie shop</h1>
<p>ยินดีต้อนรับเข้าสู่ร้าน Cutie shop ♡</p>

<!-- รูปใต้ชื่อร้าน -->
<div class="banner-box">
<img src="https://i.postimg.cc/N0rMJdDN/mi-m-ch-x-220-20260511093835.png">
</div>

<div class="badges">
<span class="badge">🎨 งานป้าย</span>
<span class="badge">💎 โลโก้</span>
<span class="badge">🌐 งานเว็บ</span>
<span class="badge">✨ Fast Work</span>
</div>

</div>

<!-- สถานะคิว -->
<div class="section">

<h3>📋 สถานะคิวงาน</h3>

<div class="price-row">
<span>คิวปัจจุบัน</span>
<span class="price-tag">เปิดรับปกติ</span>
</div>

<!-- ช่องเช็คคิว -->
<div class="queue-box">
<p style="margin-bottom:8px;color:#777;font-size:13px;">
✏️ สามารถแก้ไขคิวงานได้
</p>

<textarea>
📌 คิวที่ 01 - งานโลโก้
📌 คิวที่ 02 - งานป้าย
📌 คิวที่ 03 - งานเว็บไซต์

อัปเดตล่าสุด : 11/05/2026
</textarea>

</div>

</div>

<!-- ตัวอย่างงาน -->
<div class="section">

<h3>⭐ ตัวอย่างงาน</h3>

<div class="work-list" id="workList">

<div class="work-card">
<a href="https://example.com" target="_blank">
https://example.com
</a>
</div>

<div class="work-card">
<a href="https://example.com" target="_blank">
https://example.com
</a>
</div>

</div>

<p class="small">
เฉพาะแอดมินหรือผู้ได้รับอนุญาตเท่านั้นที่สามารถแก้ไขลิงก์ได้
</p>

</div>

<!-- บริการ -->
<div class="section">

<h3>🎨 บริการของเรา</h3>

<div class="price-row">
<span>รับทำงานป้าย</span>
<span class="price-tag">Popular</span>
</div>

<div class="price-row">
<span>รับทำโลโก้</span>
<span class="price-tag">Creative</span>
</div>

<div class="price-row">
<span>รับทำเว็บไซต์</span>
<span class="price-tag">Coding</span>
</div>

</div>

<!-- ระบบตั้งค่า -->
<div class="section">

<h3>⚙️ ระบบตั้งค่าร้าน</h3>

<div class="admin-panel">

<input type="password" id="adminPass" placeholder="กรอกรหัสแอดมิน">

<input type="text" id="newShopName" placeholder="เปลี่ยนชื่อร้าน">

<input type="text" id="newLogo" placeholder="ใส่ลิงก์รูปโปรไฟล์">

<input type="color" id="mainColor">

<button class="btn btn-outline" onclick="applySettings()">
บันทึกการตั้งค่า
</button>

<p class="admin-note">
เฉพาะผู้ที่มีรหัสผ่านและสิทธิ์เข้าถึงเท่านั้นที่สามารถแก้ไขได้
</p>

</div>

</div>

<!-- ติดต่อ -->
<div class="footer">

<h3>📱 ช่องทางติดต่อ</h3>

<div class="socials">
<a href="https://www.facebook.com/share/1KdREVYQdE/">Facebook</a>
<a href="https://discord.gg/gYuM27gh3D">Discord</a>
</div>

<p class="small">
Cutie shop © 2026 — ทุ่มเททุกความน่ารักเพื่อคุณ ♡
</p>

</div>

</div>

<script>

/* รหัสแอดมิน */
const ADMIN_PASSWORD = "1234";

/* ระบบตั้งค่า */
function applySettings(){

const pass = document.getElementById("adminPass").value;

if(pass !== ADMIN_PASSWORD){
alert("รหัสผ่านไม่ถูกต้อง");
return;
}

/* เปลี่ยนชื่อร้าน */
const newName = document.getElementById("newShopName").value;

if(newName){
document.getElementById("shopName").innerText = newName;
}

/* เปลี่ยนรูปโปรไฟล์ */
const newLogo = document.getElementById("newLogo").value;

if(newLogo){
document.querySelector(".logo img").src = newLogo;
}

/* เปลี่ยนสีเว็บ */
const newColor = document.getElementById("mainColor").value;

if(newColor){
document.documentElement.style.setProperty('--main', newColor);
}

alert("บันทึกการตั้งค่าเรียบร้อย");

}

</script>

</body>
</html>
